# Optional Sentry observability.
# Leave blank to disable Sentry.
VITE_SENTRY_DSN=

# Optional tracing sample rate for Sentry performance instrumentation.
# Valid range: 0.0 - 1.0
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional TURN fallback for remote pairing reliability.
# Set all three values together to enable TURN in WebRTC ICE servers.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
